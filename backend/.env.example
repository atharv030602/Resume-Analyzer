# ─── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:8501

# ─── Database (optional) ──────────────────────────────────────────────
# Set DB_ENABLED=false to run with no MySQL at all.
DB_ENABLED=false
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=resumefit

# ─── LLM provider ─────────────────────────────────────────────────────
# Pick one: gemini | openai. Set the matching key. Leave keys blank to run
# in deterministic (no-AI) mode.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-1.5-flash
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── RAG / vector store ───────────────────────────────────────────────
VECTOR_BACKEND=chroma          # chroma | memory
CHROMA_DIR=.chroma
RAG_TOP_K=4
CHAT_HISTORY_TURNS=8

# ─── Observability (LangSmith) ───────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resumefit-ai
